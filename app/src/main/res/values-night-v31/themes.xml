<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- API 31+ dark variant: dynamic neutral background + accent splash icon. -->
    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.PlainActivity</item>
    </style>

    <style name="Theme.PlainActivity" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
    </style>
</resources>
